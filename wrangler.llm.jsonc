{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mira-shiyan-llm",
  "main": "src/llm/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "keep_vars": true,
  "observability": { "enabled": true },
  "vars": {
    // Provider endpoint/model configuration is managed as Cloudflare Worker
    // variables and preserved across deploys by keep_vars. API keys remain
    // Cloudflare secrets. No provider-specific defaults live in the repo.
    "LLM_TIMEOUT_MS": "120000",
    "LLM_MAX_TRANSCRIPT_CHARS": "200000"
  }
}
